# Which LLM answers the questions: ollama | openai | anthropic
LLM_PROVIDER=ollama

# --- Ollama (local, free, private) ---
OLLAMA_MODEL=llama3.2
EMBED_MODEL=mxbai-embed-large

# --- OpenAI (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Anthropic / Claude (optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
